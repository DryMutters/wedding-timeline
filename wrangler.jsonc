{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wedding-timeline",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "timeline.maryannaphotography.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Pages and data go through the Worker; files under /static are served directly.
    "run_worker_first": ["/", "/admin", "/admin/*", "/t/*", "/api/*", "/_shell/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "wedding-timeline", "database_id": "e6c96aee-6d1d-459e-963f-471e58423eff" }],
  "vars": {
    // From the Cloudflare Access application "Wedding timeline builder". Neither is a secret.
    // If either is blank or wrong, the builder refuses every request.
    "ACCOUNT_ID": "mary-anna",
    "TEAM_DOMAIN": "https://crimson-block-a3e1.cloudflareaccess.com",
    "POLICY_AUD": "ed257a175a2beddd2350d13dd68ff3cc1cde996b2da762fa6f28fba1ba3ffbe3"
  }
}
