{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wedding-timeline",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "timeline.maryannaphotography.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Pages and data go through the Worker; files under /static are served directly.
    "run_worker_first": ["/", "/admin", "/admin/*", "/t/*", "/api/*", "/_shell/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "wedding-timeline", "database_id": "e6c96aee-6d1d-459e-963f-471e58423eff" }],
  "vars": {
    // From Cloudflare Zero Trust. Until both are set, the builder refuses every request.
    "ACCOUNT_ID": "mary-anna",
    "TEAM_DOMAIN": "",
    "POLICY_AUD": ""
  }
}
